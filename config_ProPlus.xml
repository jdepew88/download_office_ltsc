<Configuration>
  <!--
    Office LTSC Professional Plus 2024 (volume licensed), 64-bit.
    No product key is included: volume licensed Office LTSC 2024 installs with
    Microsoft's Generic Volume License Key (GVLK) by default, which activates
    against a KMS host or Active Directory-based activation. For MAK or manual
    activation, run Activate_Office.ps1 after installation.
    The RemoveMSI and Display elements are added at run time by
    Install_Office.ps1 when requested.
  -->
  <Add OfficeClientEdition="64" Channel="PerpetualVL2024">
    <Product ID="ProPlus2024Volume">
      <Language ID="en-us" />
      <Language ID="MatchOS" />
      <ExcludeApp ID="Lync" />
    </Product>
  </Add>
  <Property Name="FORCEAPPSHUTDOWN" Value="FALSE" />
  <Updates Enabled="TRUE" />
</Configuration>
